<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Filament admin тестовете са памет-тежки — 128MB не стигат. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <!-- SSR е изключен в тестове: Inertia вика демона през Laravel HTTP
             клиента, а всеки Http::fake() в тест го прихваща и връща отговор
             без "head" ключ → 500. SsrSmokeTest го включва изрично. -->
        <env name="INERTIA_SSR_ENABLED" value="false"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="MAIL_FROM_ADDRESS" value="novini@padok.bg"/>
        <env name="MAIL_REPLY_TO_ADDRESS" value="padokbg@gmail.com"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- Никога не зареждай реални API ключове в тестове (иначе тестове без
             Http::fake удрят реалния Anthropic/OpenF1 → 120s hang + харчат пари). -->
        <env name="ANTHROPIC_API_KEY" value=""/>
        <env name="MISTRAL_API_KEY" value=""/>
        <!-- Тестовете да не зависят от NEWS_LLM_DRIVER в локалния .env. -->
        <env name="NEWS_LLM_DRIVER" value="anthropic"/>
        <env name="OPENF1_USERNAME" value=""/>
        <env name="OPENF1_PASSWORD" value=""/>
        <!-- V2 feature flags ON in tests, за да се тества кодът зад тях. -->
        <env name="FEATURE_COMPARE" value="true"/>
        <env name="FEATURE_RIVALRIES" value="true"/>
        <env name="FEATURE_CIRCUITS" value="true"/>
        <env name="FEATURE_TSOLOV" value="true"/>
        <env name="FEATURE_HISTORY" value="true"/>
        <env name="FEATURE_F2" value="true"/>
        <env name="FEATURE_LIVE_TIMING" value="true"/>
        <env name="FEATURE_THIS_DAY" value="true"/>
        <env name="FEATURE_MCP_OPS" value="true"/>
        <!-- sql-query на MCP сървъра чете през същата in-memory sqlite база. -->
        <env name="OPS_QUERY_CONNECTION" value="sqlite"/>
    </php>
</phpunit>
