APP_NAME="Падок"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
# ВАЖНО: в production APP_URL определя canonical/og:url и 301-а от www — без схема и хост тук SEO слоят сочи грешен домейн.

APP_LOCALE=bg
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=bg_BG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=f1bulgaria
DB_USERNAME=root
DB_PASSWORD=
# MySQL потребител САМО със SELECT — за инструмента sql-query на оперативния
# MCP сървър (config/ops.php). Празно = инструментът не се регистрира.
# Създаване на прод (mysql като root):
#   CREATE USER 'padok_ro'@'localhost' IDENTIFIED BY '<парола>';
#   GRANT SELECT ON f1bulgaria.* TO 'padok_ro'@'localhost';
DB_READONLY_USERNAME=
DB_READONLY_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Продукция: MAIL_MAILER=resend + RESEND_KEY. Локално `log` пише в laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# padok.bg няма MX на главното ниво — без това отговорите на хората се губят.
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME=

RESEND_KEY=

# Линк към Телеграм за бюлетинните писма — празно скрива блока.
TELEGRAM_COMMUNITY_URL=

# Гласът на радиото в играта — само локално, за game:generate-radio-voice.
# Клиповете влизат в репото; на продукция ключът не трябва.
ELEVENLABS_API_KEY=

# Логин креденшъли на админ акаунта (padok:sync-admin).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Получател на дневния отчет (report:daily-activity); празно = ползва ADMIN_EMAIL.
ADMIN_REPORT_EMAIL=
# Получател на оперативните аларми (news:health-check — новините са спрели).
# Празно = ползва ADMIN_REPORT_EMAIL, после ADMIN_EMAIL.
ADMIN_ALERT_EMAIL=
# Оперативен MCP сървър за админа (/mcp/ops, само четене). Включва се с
# FEATURE_MCP_OPS=true (по-долу); токен: `php artisan padok:mcp-token`.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── LLM за news pipeline-а ──
# NEWS_LLM_DRIVER: anthropic (платен, най-добър български) | mistral (безплатен
# Experiment tier — ключ от console.mistral.ai, без карта; при изчерпан
# Anthropic бюджет: NEWS_LLM_DRIVER=mistral + NEWS_ENRICH_SLEEP_MS=1000).
# ВАЖНО: на прод конфигът е кеширан — след промяна тук задължително
# `sudo -u www-data php artisan config:cache` (иначе смяната тихо не влиза).
# MISTRAL_MODEL: mistral-large-latest е най-качественият български (пак
# безплатен); mistral-small-latest / mistral-medium-latest са по-бързи.
NEWS_LLM_DRIVER=anthropic
# Резервен доставчик при отказ на основния. Празно = изключен.
# Внимание: безплатен основен + платен резервен значи, че отказът на
# безплатния тихо започва да харчи по платения.
NEWS_LLM_FALLBACK_DRIVER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# ── OpenF1 (live timing по време на сесии — OAuth2 password grant) ──
# Без тези /live показва fallback. Платен акаунт (~€9.90/мес).
OPENF1_USERNAME=
OPENF1_PASSWORD=

# ── Feature flags (виж config/features.php) ──
# Цолов е част от V1 (включен по подразбиране в config). Останалите са V2 —
# пусни при нужда без code change, после `php artisan config:cache`.
FEATURE_GAME=false
# Камерата от кокпита: false = само за админите, true = за всички.
FEATURE_GAME_COCKPIT=false
# Оперативният MCP сървър (/mcp/ops) — виж config/ops.php.
FEATURE_MCP_OPS=false
# FEATURE_LIVE_TIMING=false
# FEATURE_CIRCUITS=false
# FEATURE_F2=false
# FEATURE_RIVALRIES=false
# FEATURE_HISTORY=false
# FEATURE_COMPARE=false
# FEATURE_THIS_DAY=false

# --- Аналитика (по избор; скриптът се вкарва само ако е зададено) ---
# Cookieless, не изисква cookie банер:
PLAUSIBLE_DOMAIN=
# PLAUSIBLE_SRC=https://plausible.io/js/script.js
UMAMI_WEBSITE_ID=
UMAMI_SRC=
# GA4 (връзва се със Search Console, но изисква съгласие в ЕС):
GA_MEASUREMENT_ID=

# --- IndexNow (Bing/Yandex научават за нова статия веднага) ---
# Произволен низ 32-64 hex знака. СЪЩИЯТ низ трябва да е достъпен като
# https://padok.bg/{key}.txt със съдържание самия ключ (файл в public/).
INDEXNOW_KEY=

# --- Inertia SSR ---
# Включен по подразбиране. Изисква жив демон на сървъра:
#   php artisan inertia:start-ssr   (под supervisor — виж LAUNCH.md)
# Ако демонът не върви, Inertia пада грациозно към клиентски рендер.
# Локално остави false, освен ако не тестваш точно SSR.
INERTIA_SSR_ENABLED=false

# --- Telegram канал (публикуване на резултати и новини) ---
# Ботът се създава с @BotFather, после се добавя като АДМИНИСТРАТОР в канала
# с право „Публикуване на съобщения". Токенът не влиза в git — само тук.
TELEGRAM_BOT_TOKEN=
# Числовото id на канала (започва с -100…), НЕ @username: username-ът се сменя
# при преименуване на канала и постовете спират тихо.
#   php artisan channel:resolve-chat-id @padokbg_bot
TELEGRAM_CHAT_ID=

# Главен ключ на канала. Остави false, докато не си проверил с
# `php artisan channel:post --dry-run`. Изключването не губи нищо —
# публикациите се трупат в `channel_posts` и тръгват при включване.
CHANNEL_ENABLED=false
# Само новини с importance_score над този праг. Pipeline-ът публикува на всеки
# 30 мин — без праг каналът се залива и хората го заглушават.
CHANNEL_NEWS_MIN_IMPORTANCE=7
# Прозорец назад при първо пускане — пази канала от изсипване на цял сезон.
CHANNEL_MAX_BACKFILL_HOURS=24

# --- Формула 2 (официални резултати) ---
# Няма ключ за задаване: той е константа в билда на fiaformula2.com и се вади
# по време на работа. Тези променливи се пипат само ако сменят адресите.
# F2_API_BASE_URL=https://api.formula1.com/v2/core-fom-results/f2
# F2_API_KEY_PAGE_URL=https://www.fiaformula2.com/en/racing
